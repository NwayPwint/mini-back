generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  COLLEGE
  BUSINESS
  ADMIN
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  name                  String?
  role                  Role @default(STUDENT)
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
